# Twitter/X 账号配置
# 需要至少一个 Twitter 账号来进行抓取
# 格式: username:password:email:email_password
# 例如: myuser:mypass:my@email.com:emailpass

# 推送时间配置 (24小时制，例如 09:00)
DAILY_PUSH_TIME=09:00

# 搜索的 XR 关键词 (用逗号分隔)
XR_KEYWORDS=XR,VR,AR,virtual reality,augmented reality,mixed reality,metaverse

# 每次抓取的帖子数量
TOP_POST_COUNT=3
